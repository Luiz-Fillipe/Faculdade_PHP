# Copie este arquivo para ".env" (na raiz do projeto) e preencha com os dados
# do SEU serviço no Aiven (Connection information). O ".env" nunca vai para o Git.
#
# Banco local (XAMPP): deixe PORTAL_DB_SSLMODE vazio e use localhost / 5432.

PORTAL_DB_HOST=HOST_DO_AIVEN
PORTAL_DB_PORT=PORTA_DO_AIVEN
PORTAL_DB_NAME=portal_grupoXX
PORTAL_DB_USER=avnadmin
PORTAL_DB_PASSWORD=SENHA_DO_POSTGRESQL
PORTAL_DB_SSLMODE=require
